!dataset/masks/.gitkeep

# Outputs
outputs/predictions/*
outputs/heatmaps/*
outputs/evaluation/*
!outputs/predictions/.gitkeep
!outputs/heatmaps/.gitkeep
!outputs/evaluation/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/

